<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nexus.Views.MoreSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Settings-app style: one card per setting, title and description left, action right -->
    <Grid ColumnSpacing="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="Guide button" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xF0E2;" FontSize="20" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Windows Game Bar" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="GameBarStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="GameBarButton" Grid.Column="2" Click="GameBar_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7FC;" FontSize="20" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Steam" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="SteamStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Steam settings" Click="Steam_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="2,6,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Keyboard: Win + Shift + G opens Nexus. A StreamDock key can run Nexus.exe --toggle." />
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="Nexus" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Start with Windows" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="Ready the moment you press Guide" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="Startup_Toggled" AutomationProperties.Name="Start with Windows" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Open log folder" Click="Log_Click" />
                    <Button Content="Quit Nexus" Click="Quit_Click" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Margin="2,6,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nexus.Views.MoreSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One glass card per setting: title and description left, action right -->
    <Grid ColumnSpacing="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="Guide button" Style="{StaticResource SectionHeaderStyle}" Margin="4,0,0,4" />
            <Border Style="{StaticResource GlassSurface}" Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xF0E2;" FontSize="20" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Windows Game Bar" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="GameBarStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                    <Button x:Name="GameBarButton" Grid.Column="2" Style="{StaticResource GlassButtonStyle}" Click="GameBar_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource GlassSurface}" Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7FC;" FontSize="20" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Steam" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="SteamStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource GlassButtonStyle}" Content="Steam settings" Click="Steam_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource GlassSurface}" Padding="20,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE740;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="Overlay size" Style="{StaticResource BodyTextBlockStyle}" />
                        <Slider x:Name="SizeSlider" Style="{StaticResource NexusSliderStyle}" Minimum="40" Maximum="70" StepFrequency="1"
                                SmallChange="1" ValueChanged="Size_Changed" AutomationProperties.Name="Overlay size" />
                    </StackPanel>
                    <TextBlock x:Name="SizeValue" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="Nexus" Style="{StaticResource SectionHeaderStyle}" Margin="4,0,0,4" />
            <Border Style="{StaticResource GlassSurface}" Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Start with Windows" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="Ready the moment you press Guide" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="Startup_Toggled" AutomationProperties.Name="Start with Windows" />
                </Grid>
            </Border>
            <Border Style="{StaticResource GlassSurface}" Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Controller pop-ups" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="Connected, disconnected, battery low" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ToastSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="Toasts_Toggled" AutomationProperties.Name="Controller pop-ups" />
                </Grid>
            </Border>
            <Border Style="{StaticResource GlassSurface}" Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="UpdateButton" Style="{StaticResource GlassButtonStyle}" Content="Check for updates" Click="Update_Click" />
                    <Button Style="{StaticResource GlassButtonStyle}" Content="Logs" Click="Log_Click" />
                    <Button Style="{StaticResource GlassButtonStyle}" Content="Quit Nexus" Click="Quit_Click" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Margin="2,6,0,0"
                       Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nexus.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Jump back in" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="HomeButton" Style="{StaticResource GlassButtonStyle}" Click="Home_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE80F;" FontSize="18" />
                        <TextBlock Text="Home" />
                    </StackPanel>
                </Button>
                <Button x:Name="LibraryButton" Style="{StaticResource GlassButtonStyle}" Click="Library_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8F1;" FontSize="18" />
                        <TextBlock Text="Library" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="CardScroller" Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="6">
            <StackPanel x:Name="Cards" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" />
        </ScrollViewer>
        <TextBlock x:Name="NoRecentText" Grid.Row="1" Text="Games you play on Steam show up here."
                   Style="{StaticResource RowSubtitleStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />

        <Border Grid.Row="2" Style="{StaticResource GlassSurface}" CornerRadius="40" Padding="12,8" HorizontalAlignment="Center">
            <StackPanel x:Name="Dock" Orientation="Horizontal" Spacing="12" />
        </Border>
    </Grid>
</UserControl>

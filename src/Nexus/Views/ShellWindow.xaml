<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Nexus.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nexus">

    <!-- The window covers the game's monitor; its acrylic backdrop blurs the game. -->
    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- Fluent motion: decelerate in (fast start, soft landing), accelerate out. -->
            <Storyboard x:Name="ShowStory">
                <DoubleAnimation Storyboard.TargetName="PanelTransform" Storyboard.TargetProperty="TranslateY"
                                 From="36" To="0" Duration="0:0:0.33">
                    <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="7" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Panel" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.167" />
                <DoubleAnimation Storyboard.TargetName="Scrim" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.25" />
            </Storyboard>
            <Storyboard x:Name="HideStory">
                <DoubleAnimation Storyboard.TargetName="PanelTransform" Storyboard.TargetProperty="TranslateY"
                                 To="24" Duration="0:0:0.15">
                    <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseIn" Exponent="4" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Panel" Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.15" />
                <DoubleAnimation Storyboard.TargetName="Scrim" Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.15" />
            </Storyboard>
        </Grid.Resources>

        <Rectangle x:Name="Scrim" Fill="{StaticResource ScrimBrush}" PointerPressed="Scrim_PointerPressed" />

        <!-- Designed at a fixed size and scaled to fit, so it reads the same on a monitor or a TV. -->
        <Viewbox x:Name="PanelBox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="Panel" Width="1180" Height="640" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="PanelTransform" />
                </Grid.RenderTransform>

                <Border x:Name="Surface" Background="{StaticResource PanelBrush}" CornerRadius="8"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1" />

                <Grid Padding="20,10,24,14" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Tabs | battery, clock -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                            <SelectorBarItem x:Name="TabHome" Text="Home" Tag="home">
                                <SelectorBarItem.Icon><FontIcon Glyph="&#xE80F;" /></SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem x:Name="TabSettings" Text="Settings" Tag="settings">
                                <SelectorBarItem.Icon><FontIcon Glyph="&#xE713;" /></SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem x:Name="TabAudio" Text="Audio" Tag="audio">
                                <SelectorBarItem.Icon><FontIcon Glyph="&#xE767;" /></SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem x:Name="TabSocial" Text="Social" Tag="social">
                                <SelectorBarItem.Icon><FontIcon Glyph="&#xE716;" /></SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem x:Name="TabMulti" Text="Apps" Tag="multitask">
                                <SelectorBarItem.Icon><FontIcon Glyph="&#xE7C4;" /></SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem x:Name="TabWidgets" Text="Widgets" Tag="widgets">
                                <SelectorBarItem.Icon><FontIcon Glyph="&#xF0E2;" /></SelectorBarItem.Icon>
                            </SelectorBarItem>
                        </SelectorBar>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                            <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <FontIcon x:Name="BatteryGlyph" Glyph="&#xE7FC;" FontSize="16" />
                                <TextBlock x:Name="BatteryText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ClockText" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Sub-page title (More settings and similar) -->
                    <StackPanel x:Name="SubHeader" Grid.Row="1" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" Margin="0,6,0,0">
                        <Button Style="{StaticResource IconButtonStyle}" Click="Back_Click" AutomationProperties.Name="Back">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        </Button>
                        <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <ContentControl x:Name="ContentHost" Grid.Row="2" IsTabStop="False" Margin="4,8,0,0"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ContentControl.ContentTransitions>
                            <TransitionCollection>
                                <ContentThemeTransition HorizontalOffset="28" VerticalOffset="0" />
                            </TransitionCollection>
                        </ContentControl.ContentTransitions>
                    </ContentControl>

                    <!-- Controller hints, with the Windows gamepad glyphs -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right"
                                Opacity="0.78">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF10C;" FontSize="18" />
                            <FontIcon Glyph="&#xF10D;" FontSize="18" />
                            <TextBlock Text="Switch tab" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF093;" FontSize="18" />
                            <TextBlock Text="Select" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF094;" FontSize="18" />
                            <TextBlock Text="Back" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="YHint" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <FontIcon Glyph="&#xF095;" FontSize="18" />
                            <TextBlock x:Name="YHintText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Nexus.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nexus">

    <!--
        A compact glass panel in the middle of the screen. The window covers the game's monitor and
        its acrylic backdrop blurs the whole game behind the panel, with a soft vignette on top.
    -->
    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- Decelerate in (fast start, soft landing), accelerate out. -->
            <Storyboard x:Name="ShowStory">
                <DoubleAnimation Storyboard.TargetName="PanelTransform" Storyboard.TargetProperty="ScaleX"
                                 From="0.96" To="1" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PanelTransform" Storyboard.TargetProperty="ScaleY"
                                 From="0.96" To="1" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="PanelTransform" Storyboard.TargetProperty="TranslateY"
                                 From="10" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Panel" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.14" />
                <DoubleAnimation Storyboard.TargetName="Scrim" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.18" />
                <DoubleAnimation Storyboard.TargetName="Backdrop" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.16" />
                <DoubleAnimation Storyboard.TargetName="AmbientLayers" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.3" />
            </Storyboard>
            <Storyboard x:Name="HideStory">
                <DoubleAnimation Storyboard.TargetName="PanelTransform" Storyboard.TargetProperty="ScaleX"
                                 To="0.97" Duration="0:0:0.15" />
                <DoubleAnimation Storyboard.TargetName="PanelTransform" Storyboard.TargetProperty="ScaleY"
                                 To="0.97" Duration="0:0:0.15" />
                <DoubleAnimation Storyboard.TargetName="Panel" Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.15" />
                <DoubleAnimation Storyboard.TargetName="Scrim" Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.15" />
                <DoubleAnimation Storyboard.TargetName="Backdrop" Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.15" />
                <DoubleAnimation Storyboard.TargetName="AmbientLayers" Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.15" />
            </Storyboard>
        </Grid.Resources>

        <!-- A light vignette over the blur; clicking it closes the overlay -->
        <!-- A still, blurred frame of the screen taken as the overlay opens (see ScreenBlur) -->
        <!-- The screen as it was when the overlay opened: shown at once so opening never flashes -->
        <Grid x:Name="SharpFrame" IsHitTestVisible="False">
            <Image x:Name="SharpImage" Stretch="Fill" />
        </Grid>
        <Grid x:Name="Backdrop" Opacity="0" IsHitTestVisible="False">
            <!-- SDR fallback; the HDR frame is a composition visual on top of this grid (HdrBackdrop) -->
            <Image x:Name="BackdropImage" Stretch="Fill" />
        </Grid>

        <Rectangle x:Name="Scrim" PointerPressed="Scrim_PointerPressed">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="0.5" />
                    <GradientStop Color="#2E000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Ambient glow behind the panel, tinted by the focused game's art. Two layers: a new colour fades
             in on one while the other fades out (opacity animations run on the compositor, so they stay smooth). -->
        <Grid x:Name="AmbientLayers" IsHitTestVisible="False">
            <Rectangle x:Name="AmbientA">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.52" GradientOrigin="0.5,0.52" RadiusX="0.42" RadiusY="0.5">
                        <GradientStop x:Name="AmbientAInner" Color="#00000000" Offset="0" />
                        <GradientStop x:Name="AmbientAMid" Color="#00000000" Offset="0.55" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="AmbientB" Opacity="0">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.52" GradientOrigin="0.5,0.52" RadiusX="0.42" RadiusY="0.5">
                        <GradientStop x:Name="AmbientBInner" Color="#00000000" Offset="0" />
                        <GradientStop x:Name="AmbientBMid" Color="#00000000" Offset="0.55" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Designed at a fixed size and scaled to fit, so it reads the same on a monitor or a TV. -->
        <Viewbox x:Name="PanelBox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="Panel" Width="1180" RowSpacing="12" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="PanelTransform" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top bar: clock | tab pill | controller battery -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ClockChip" Style="{StaticResource GlassSurface}" CornerRadius="18" Padding="14,6"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource GlassChipFill}">
                        <TextBlock x:Name="ClockText" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="15" />
                    </Border>

                    <Border x:Name="TabPill" Grid.Column="1" Style="{StaticResource GlassSurface}" CornerRadius="30" Padding="4" Background="{StaticResource GlassChipFill}">
                        <Grid>
                            <Border x:Name="Lens" Width="80" Height="52" CornerRadius="26" HorizontalAlignment="Left"
                                    Background="{StaticResource LensFill}" BorderBrush="{StaticResource LensRim}" BorderThickness="1">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="LensSlide" />
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="2">
                                <Button x:Name="TabHome" Tag="home" Style="{StaticResource TabButtonStyle}" Click="Tab_Click" AutomationProperties.Name="Home">
                                    <StackPanel Spacing="2"><FontIcon Glyph="&#xE80F;" FontSize="17" /><TextBlock Text="Home" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button x:Name="TabSettings" Tag="settings" Style="{StaticResource TabButtonStyle}" Click="Tab_Click" AutomationProperties.Name="Settings">
                                    <StackPanel Spacing="2"><FontIcon Glyph="&#xE713;" FontSize="17" /><TextBlock Text="Settings" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button x:Name="TabAudio" Tag="audio" Style="{StaticResource TabButtonStyle}" Click="Tab_Click" AutomationProperties.Name="Audio">
                                    <StackPanel Spacing="2"><FontIcon Glyph="&#xE767;" FontSize="17" /><TextBlock Text="Audio" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button x:Name="TabSocial" Tag="social" Style="{StaticResource TabButtonStyle}" Click="Tab_Click" AutomationProperties.Name="Social">
                                    <StackPanel Spacing="2"><FontIcon Glyph="&#xE716;" FontSize="17" /><TextBlock Text="Social" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button x:Name="TabMulti" Tag="multitask" Style="{StaticResource TabButtonStyle}" Click="Tab_Click" AutomationProperties.Name="Apps">
                                    <StackPanel Spacing="2"><FontIcon Glyph="&#xE7C4;" FontSize="17" /><TextBlock Text="Apps" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button x:Name="TabWidgets" Tag="widgets" Style="{StaticResource TabButtonStyle}" Click="Tab_Click" AutomationProperties.Name="Widgets">
                                    <StackPanel Spacing="2"><FontIcon Glyph="&#xF0E2;" FontSize="17" /><TextBlock Text="Widgets" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Controllers (battery) and Power, in the corner like a console's top bar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BatteryChip" Style="{StaticResource GlassButtonStyle}" Background="{StaticResource GlassChipFill}"
                                MinHeight="36" Height="36" Padding="12,0" CornerRadius="18" Visibility="Collapsed" Click="Controllers_Click"
                                AutomationProperties.Name="Controllers">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="BatteryGlyph" Glyph="&#xE7FC;" FontSize="15" />
                                <TextBlock x:Name="BatteryText" Style="{StaticResource BodyTextBlockStyle}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PowerButton" Style="{StaticResource GlassButtonStyle}" Background="{StaticResource GlassChipFill}"
                                MinHeight="36" Width="36" Height="36" Padding="0" CornerRadius="18" Click="Power_Click"
                                AutomationProperties.Name="Power" ToolTipService.ToolTip="Power">
                            <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Content glass -->
                <Border x:Name="ContentGlass" Grid.Row="1" Height="330" Background="{StaticResource GlassPanelFill}"
                        BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="36" Padding="22,16,22,18">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Only sub-pages have a title; on tabs the pill already says where you are -->
                        <StackPanel x:Name="SubHeader" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                            <Button Style="{StaticResource IconButtonStyle}" Background="{StaticResource GlassFill}" Click="Back_Click" AutomationProperties.Name="Back">
                                <FontIcon Glyph="&#xE72B;" FontSize="15" />
                            </Button>
                            <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ContentControl x:Name="ContentHost" Grid.Row="1" IsTabStop="False"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <ContentControl.ContentTransitions>
                                <TransitionCollection>
                                    <ContentThemeTransition HorizontalOffset="36" VerticalOffset="0" />
                                </TransitionCollection>
                            </ContentControl.ContentTransitions>
                        </ContentControl>
                    </Grid>
                </Border>

                <!-- Controller hints, with the Windows gamepad glyphs -->
                <Border x:Name="HintPill" Grid.Row="2" Style="{StaticResource GlassSurface}" CornerRadius="16" Padding="16,6" HorizontalAlignment="Center" Background="{StaticResource GlassChipFill}">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF10C;" FontSize="16" />
                            <FontIcon Glyph="&#xF10D;" FontSize="16" />
                            <TextBlock Text="Tabs" Style="{StaticResource BodyTextBlockStyle}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF093;" FontSize="16" Foreground="#FF6FD36F" />
                            <TextBlock x:Name="AHintText" Text="Select" Style="{StaticResource BodyTextBlockStyle}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xF094;" FontSize="16" Foreground="#FFFF6B6B" />
                            <TextBlock Text="Back" Style="{StaticResource BodyTextBlockStyle}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="XHint" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <FontIcon Glyph="&#xF096;" FontSize="16" Foreground="#FF5AA9FF" />
                            <TextBlock x:Name="XHintText" Style="{StaticResource BodyTextBlockStyle}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="YHint" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <FontIcon Glyph="&#xF095;" FontSize="16" Foreground="#FFFFD24A" />
                            <TextBlock x:Name="YHintText" Style="{StaticResource BodyTextBlockStyle}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The focus ring is drawn here, above everything in the panel (see ShellWindow.SetupFocusRing) -->
                <Canvas x:Name="FocusLayer" Grid.RowSpan="3" IsHitTestVisible="False" />
            </Grid>
        </Viewbox>
    </Grid>
</Window>

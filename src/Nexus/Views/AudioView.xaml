<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nexus.Views.AudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="26">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: output and input, each a device picker over a level pill with its mute button -->
        <StackPanel x:Name="DeviceStack" Spacing="8" VerticalAlignment="Center">
            <ComboBox x:Name="OutputBox" Style="{StaticResource NexusComboStyle}" PlaceholderText="Output device"
                      DropDownClosed="Output_Closed" AutomationProperties.Name="Output device" />
            <Border x:Name="OutPill" Style="{StaticResource GlassSurface}" CornerRadius="24" Padding="6,2,16,2">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SpeakerMute" Style="{StaticResource IconButtonStyle}" Background="{StaticResource IconCircleBrush}"
                            Click="Speaker_Click" AutomationProperties.Name="Mute speakers">
                        <FontIcon x:Name="SpeakerGlyph" Glyph="&#xE767;" FontSize="16" />
                    </Button>
                    <Slider x:Name="OutSlider" Grid.Column="1" Style="{StaticResource NexusSliderStyle}" Minimum="0" Maximum="100"
                            SmallChange="2" VerticalAlignment="Center" ValueChanged="Out_Changed" AutomationProperties.Name="Volume" />
                    <TextBlock x:Name="OutValue" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
            </Border>
            <ComboBox x:Name="InputBox" Style="{StaticResource NexusComboStyle}" PlaceholderText="Input device" Margin="0,8,0,0"
                      DropDownClosed="Input_Closed" AutomationProperties.Name="Input device" />
            <Border Style="{StaticResource GlassSurface}" CornerRadius="24" Padding="6,2,16,2">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MicMute" Style="{StaticResource IconButtonStyle}" Background="{StaticResource IconCircleBrush}"
                            Click="Mic_Click" AutomationProperties.Name="Mute microphone">
                        <FontIcon x:Name="MicGlyph" Glyph="&#xE720;" FontSize="16" />
                    </Button>
                    <Slider x:Name="MicSlider" Grid.Column="1" Style="{StaticResource NexusSliderStyle}" Minimum="0" Maximum="100"
                            SmallChange="2" VerticalAlignment="Center" ValueChanged="Mic_Changed" AutomationProperties.Name="Microphone level" />
                    <TextBlock x:Name="MicValue" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
            </Border>
            <HyperlinkButton Content="More sound settings" Click="Manage_Click" Foreground="{StaticResource SubtleTextBrush}" Padding="6,4" />
        </StackPanel>

        <!-- Right: the mixer as channel strips -->
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Volume mixer" Style="{StaticResource SectionHeaderStyle}" Margin="4,0,0,0" />
            <ScrollViewer x:Name="StripScroller" Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="4">
                <StackPanel x:Name="Strips" Orientation="Horizontal" Spacing="14" />
            </ScrollViewer>
            <TextBlock x:Name="NoAppsText" Grid.Row="1" Text="Apps playing sound show up here." Visibility="Collapsed"
                       Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource SubtleTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>

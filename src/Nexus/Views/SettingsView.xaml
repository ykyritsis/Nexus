<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nexus.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Control Center style: square tiles, wide tiles for things with a slider or a status line -->
    <Grid x:Name="TileGrid" ColumnSpacing="14" RowSpacing="14" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="150" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <Button x:Name="MicTile" Style="{StaticResource TileStyle}" Click="Mic_Click" />

        <!-- Volume: a wide glass tile with its own mute button and slider -->
        <Border Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource GlassSurface}" Padding="20,16">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Volume" Style="{StaticResource RowTitleStyle}" />
                    <TextBlock x:Name="VolumeValue" HorizontalAlignment="Right" FontSize="17" FontWeight="SemiBold" />
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="16" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SpeakerMute" Style="{StaticResource IconButtonStyle}" Width="56" Height="56"
                            Background="{StaticResource IconCircleBrush}" Click="SpeakerMute_Click">
                        <FontIcon x:Name="SpeakerGlyph" Glyph="&#xE767;" FontSize="22" />
                    </Button>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource NexusSliderStyle}"
                            Minimum="0" Maximum="100" SmallChange="2" StepFrequency="1" VerticalAlignment="Center"
                            ValueChanged="Volume_Changed" />
                </Grid>
            </Grid>
        </Border>

        <Button x:Name="KeyboardTile" Grid.Column="4" Style="{StaticResource TileStyle}" Click="Keyboard_Click" />
        <Button x:Name="XboxTile" Grid.Column="5" Style="{StaticResource TileStyle}" Click="Xbox_Click" />
        <Button x:Name="CompactTile" Grid.Column="6" Style="{StaticResource TileStyle}" Click="Compact_Click" />

        <Button x:Name="NetworkTile" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource TileStyle}" Click="Network_Click" />
        <Button x:Name="BluetoothTile" Grid.Row="1" Grid.Column="2" Style="{StaticResource TileStyle}" Click="Bluetooth_Click" />
        <Button x:Name="AirplaneTile" Grid.Row="1" Grid.Column="3" Style="{StaticResource TileStyle}" Click="Airplane_Click" />
        <Button x:Name="CursorTile" Grid.Row="1" Grid.Column="4" Style="{StaticResource TileStyle}" Click="Cursor_Click" />
        <Button x:Name="GameBarTile" Grid.Row="1" Grid.Column="5" Style="{StaticResource TileStyle}" Click="GameBar_Click" />
        <Button x:Name="MoreTile" Grid.Row="1" Grid.Column="6" Style="{StaticResource TileStyle}" Click="More_Click" />
    </Grid>
</UserControl>

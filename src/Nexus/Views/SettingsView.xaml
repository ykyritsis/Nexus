<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nexus.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Control Center: glass tiles on the left, sound on the right -->
    <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="TileGrid" ColumnSpacing="14" RowSpacing="14" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="128" />
                <RowDefinition Height="128" />
            </Grid.RowDefinitions>
            <Button x:Name="MicTile" Style="{StaticResource TileStyle}" Click="Mic_Click" />
            <Button x:Name="BluetoothTile" Grid.Column="1" Style="{StaticResource TileStyle}" Click="Bluetooth_Click" />
            <Button x:Name="AirplaneTile" Grid.Column="2" Style="{StaticResource TileStyle}" Click="Airplane_Click" />
            <Button x:Name="XboxTile" Grid.Column="3" Style="{StaticResource TileStyle}" Click="Xbox_Click" />
            <Button x:Name="ScreenshotTile" Grid.Column="4" Style="{StaticResource TileStyle}" Click="Screenshot_Click" />
            <Button x:Name="NetworkTile" Grid.Row="1" Style="{StaticResource TileStyle}" Click="Network_Click" />
            <Button x:Name="KeyboardTile" Grid.Row="1" Grid.Column="1" Style="{StaticResource TileStyle}" Click="Keyboard_Click" />
            <Button x:Name="CursorTile" Grid.Row="1" Grid.Column="2" Style="{StaticResource TileStyle}" Click="Cursor_Click" />
            <Button x:Name="CompactTile" Grid.Row="1" Grid.Column="3" Style="{StaticResource TileStyle}" Click="Compact_Click" />
            <Button x:Name="GameBarTile" Grid.Row="1" Grid.Column="4" Style="{StaticResource TileStyle}" Click="GameBar_Click" />
        </Grid>

        <!-- Sound, plus More settings -->
        <Grid Grid.Column="1" RowSpacing="14" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource GlassSurface}" Padding="20,16">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Sound" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SpeakerMute" Style="{StaticResource IconButtonStyle}" Background="{StaticResource IconCircleBrush}"
                                Click="SpeakerMute_Click" AutomationProperties.Name="Mute speakers">
                            <FontIcon x:Name="SpeakerGlyph" Glyph="&#xE767;" FontSize="16" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource NexusSliderStyle}" Minimum="0" Maximum="100"
                                SmallChange="2" VerticalAlignment="Center" ValueChanged="Volume_Changed" AutomationProperties.Name="Volume" />
                        <TextBlock x:Name="VolumeValue" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MicMute" Style="{StaticResource IconButtonStyle}" Background="{StaticResource IconCircleBrush}"
                                Click="MicMute_Click" AutomationProperties.Name="Mute microphone">
                            <FontIcon x:Name="MicGlyph" Glyph="&#xE720;" FontSize="16" />
                        </Button>
                        <Slider x:Name="MicSlider" Grid.Column="1" Style="{StaticResource NexusSliderStyle}" Minimum="0" Maximum="100"
                                SmallChange="2" VerticalAlignment="Center" ValueChanged="Mic_Changed" AutomationProperties.Name="Microphone level" />
                        <TextBlock x:Name="MicValue" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                    <Button x:Name="OutputButton" Style="{StaticResource GlassButtonStyle}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" Click="Output_Click" Margin="0,4,0,0">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F5;" FontSize="14" />
                            <TextBlock x:Name="OutputName" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
            <Button x:Name="MoreButton" Grid.Row="1" Style="{StaticResource GlassButtonStyle}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Click="More_Click">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <TextBlock Grid.Column="1" Text="More settings" VerticalAlignment="Center" />
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" />
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>

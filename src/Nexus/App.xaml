<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Nexus.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Liquid glass on top of Windows' own controls. Every glass surface is three layers:
                  fill   a faint white gradient, brighter at the top like light on curved glass
                  rim    a 1px gradient border, bright top-left and bottom-right (the specular edge)
                  blur   the window's acrylic backdrop underneath does the frosting
                Accents follow the Windows accent colour; text uses the Windows type ramp.
            -->
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />

            <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
                <!-- light at the top edge, a little shade lower down so white text holds over bright scenes -->
                <GradientStop Color="#38FFFFFF" Offset="0" />
                <GradientStop Color="#0AFFFFFF" Offset="0.4" />
                <GradientStop Color="#2B0A0E18" Offset="1" />
            </LinearGradientBrush>
            <!-- The big panel: a touch darker than the small pieces so text reads over bright scenes -->
            <LinearGradientBrush x:Key="GlassPanelFill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#40505A6E" Offset="0" />
                <GradientStop Color="#4D262B38" Offset="0.35" />
                <GradientStop Color="#591A1E28" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#99FFFFFF" Offset="0" />
                <GradientStop Color="#26FFFFFF" Offset="0.22" />
                <GradientStop Color="#0AFFFFFF" Offset="0.55" />
                <GradientStop Color="#1AFFFFFF" Offset="0.8" />
                <GradientStop Color="#59FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LensFill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#40FFFFFF" Offset="0" />
                <GradientStop Color="#140A0E18" Offset="0.6" />
                <GradientStop Color="#2EFFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LensRim" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#CCFFFFFF" Offset="0" />
                <GradientStop Color="#33FFFFFF" Offset="0.5" />
                <GradientStop Color="#80FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <!-- "On" tiles: bright frosted white, like Control Center -->
            <LinearGradientBrush x:Key="ActiveFill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FAFFFFFF" Offset="0" />
                <GradientStop Color="#E6E8EEF7" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ActiveForeground" Color="#FF12151C" />
            <SolidColorBrush x:Key="IdleForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="IconCircleBrush" Color="#26FFFFFF" />

            <!-- Glass-friendly control colours -->
            <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#66FFFFFF" />

            <!-- A soft accent ring just outside the glass; it follows each control's rounding -->
            <!-- Nexus draws its own sliding focus ring; these only apply if it can't -->
            <Style x:Key="FocusBase" TargetType="Control">
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FocusVisualMargin" Value="-4" />
            </Style>

            <!-- Tab bar items (transparent: the sliding lens behind them shows the selection) -->
            <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="Width" Value="80" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FocusVisualMargin" Value="-2" />
            </Style>

            <!-- Glass pill buttons -->
            <Style x:Key="GlassButtonStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- Control-Center tiles -->
            <Style x:Key="TileStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- Game tiles -->
            <Style x:Key="GameTileStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualMargin" Value="-5" />
            </Style>

            <!-- Round icon buttons (launcher dock, stars, mute, back) -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="NexusSliderStyle" TargetType="Slider" BasedOn="{StaticResource FocusBase}">
                <Setter Property="FocusVisualMargin" Value="-8,-6" />
            </Style>

            <Style x:Key="NexusComboStyle" TargetType="ComboBox" BasedOn="{StaticResource FocusBase}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="Padding" Value="14,0,8,0" />
            </Style>

            <!-- Small floating pieces (clock, tabs, hints) carry a little more shade: they sit on the game directly -->
            <LinearGradientBrush x:Key="GlassChipFill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3DFFFFFF" Offset="0" />
                <GradientStop Color="#33101420" Offset="0.45" />
                <GradientStop Color="#4D101420" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="GlassSurface" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="24" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                <Setter Property="CharacterSpacing" Value="30" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

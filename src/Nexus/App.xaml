<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Nexus.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Liquid glass. Every glass surface is three layers:
                  fill   a faint white gradient, brighter at the top like light hitting curved glass
                  rim    a 1px gradient border, bright top-left and bottom-right (the specular edge)
                  blur   the window's acrylic backdrop underneath does the actual frosting
            -->
            <Color x:Key="NexusAccent">#6CD2FF</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource NexusAccent}" />

            <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2EFFFFFF" Offset="0" />
                <GradientStop Color="#14FFFFFF" Offset="0.45" />
                <GradientStop Color="#0CFFFFFF" Offset="1" />
            </LinearGradientBrush>
            <!-- The big panel is darker glass so it reads over bright scenes too -->
            <LinearGradientBrush x:Key="GlassPanelFill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#523A404C" Offset="0" />
                <GradientStop Color="#66181C24" Offset="0.3" />
                <GradientStop Color="#7310131A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#99FFFFFF" Offset="0" />
                <GradientStop Color="#26FFFFFF" Offset="0.22" />
                <GradientStop Color="#0AFFFFFF" Offset="0.55" />
                <GradientStop Color="#1AFFFFFF" Offset="0.8" />
                <GradientStop Color="#59FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LensFill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#4DFFFFFF" Offset="0" />
                <GradientStop Color="#1FFFFFFF" Offset="0.6" />
                <GradientStop Color="#2EFFFFFF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LensRim" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#CCFFFFFF" Offset="0" />
                <GradientStop Color="#33FFFFFF" Offset="0.5" />
                <GradientStop Color="#80FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <!-- "On" tiles: bright frosted white like Control Center -->
            <LinearGradientBrush x:Key="ActiveFill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FAFFFFFF" Offset="0" />
                <GradientStop Color="#E6E8EEF7" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ActiveForeground" Color="#FF12151C" />
            <SolidColorBrush x:Key="IdleForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="FaintTextBrush" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="IconCircleBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF" />

            <!-- Lightweight styling: accent sliders and toggles -->
            <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentBrush" />
            <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentBrush" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFE6ECF5" />
            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="AccentBrush" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF10141A" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FF10141A" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#66FFFFFF" />

            <x:Double x:Key="BodySize">17</x:Double>

            <!-- Shared focus look: a soft accent ring that sits just outside the glass -->
            <Style x:Key="FocusBase" TargetType="Control">
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="3" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FocusVisualMargin" Value="-4" />
            </Style>

            <!-- Tab bar items (transparent: the sliding lens behind them shows the selection) -->
            <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="Width" Value="92" />
                <Setter Property="Height" Value="62" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="31" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FocusVisualMargin" Value="-2" />
            </Style>

            <!-- Glass pill buttons -->
            <Style x:Key="GlassButtonStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Padding" Value="22,0" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="FontSize" Value="{StaticResource BodySize}" />
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- Control-Center style tiles -->
            <Style x:Key="TileStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="18,16" />
                <Setter Property="CornerRadius" Value="30" />
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- Game cards -->
            <Style x:Key="CardStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualMargin" Value="-5" />
            </Style>

            <!-- Round icon buttons (launcher dock, stars, back) -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="NexusSliderStyle" TargetType="Slider" BasedOn="{StaticResource FocusBase}">
                <Setter Property="FocusVisualMargin" Value="-8,-6" />
            </Style>

            <Style x:Key="NexusComboStyle" TargetType="ComboBox" BasedOn="{StaticResource FocusBase}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="18,0,10,0" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                <Setter Property="CharacterSpacing" Value="30" />
            </Style>
            <Style x:Key="RowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource BodySize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="RowSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="GlassSurface" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="30" />
            </Style>

            <Style x:Key="HintKeyStyle" TargetType="Border">
                <Setter Property="Background" Value="#2EFFFFFF" />
                <Setter Property="BorderBrush" Value="#40FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Padding" Value="8,1" />
                <Setter Property="MinWidth" Value="24" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

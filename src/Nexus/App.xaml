<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Nexus.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Smoked glass, flat and quiet: translucent fills over the window's blur, one even hairline
                edge, no gloss or glints. Small pieces are lighter glass; the panel and floating chips are
                darker so text holds over bright games. Text is Inter.
            -->
            <FontFamily x:Key="NexusFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
            <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="GlassFill" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="GlassPanelFill" Color="#5C111318" />
            <SolidColorBrush x:Key="GlassRim" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="LensFill" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="LensRim" Color="#33FFFFFF" />
            <!-- "On" tiles: solid frosted white, like Control Center -->
            <SolidColorBrush x:Key="ActiveFill" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="ActiveForeground" Color="#FF12151C" />
            <SolidColorBrush x:Key="IdleForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="IconCircleBrush" Color="#1FFFFFFF" />

            <!-- Glass-friendly control colours -->
            <SolidColorBrush x:Key="SliderTrackFill" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#66FFFFFF" />

            <!-- A soft accent ring just outside the glass; it follows each control's rounding -->
            <!-- Nexus draws its own sliding focus ring; these only apply if it can't -->
            <Style x:Key="FocusBase" TargetType="Control">
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="FocusVisualPrimaryThickness" Value="2" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FocusVisualMargin" Value="-4" />
            </Style>

            <!-- Tab bar items (transparent: the sliding lens behind them shows the selection) -->
            <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="Width" Value="80" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FocusVisualMargin" Value="-2" />
            </Style>

            <!-- Glass pill buttons -->
            <Style x:Key="GlassButtonStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- Control-Center tiles -->
            <Style x:Key="TileStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <!-- Game tiles -->
            <Style x:Key="GameTileStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualMargin" Value="-5" />
            </Style>

            <!-- Round icon buttons (launcher dock, stars, mute, back) -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource FocusBase}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style x:Key="NexusSliderStyle" TargetType="Slider" BasedOn="{StaticResource FocusBase}">
                <Setter Property="FocusVisualMargin" Value="-8,-6" />
            </Style>

            <Style x:Key="NexusComboStyle" TargetType="ComboBox" BasedOn="{StaticResource FocusBase}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="Padding" Value="14,0,8,0" />
            </Style>

            <!-- Small floating pieces (clock, tabs, hints) carry a little more shade: they sit on the game directly -->
            <SolidColorBrush x:Key="GlassChipFill" Color="#6B111318" />

            <Style x:Key="GlassSurface" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="24" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                <Setter Property="CharacterSpacing" Value="30" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
